# Copier ce fichier en .env puis adapter. Ne jamais committer .env.
# Valeurs d'exemple pour le développement local uniquement.

POSTGRES_DB=trame
POSTGRES_USER=trame
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_PORT=5432

# Lue automatiquement depuis ce fichier par les scripts npm et les tests de api/.
# Hôte 127.0.0.1 (et non localhost) ; adapter le port à POSTGRES_PORT.
DATABASE_URL=postgres://trame:changeme-local-only@127.0.0.1:5432/trame
# Connexion Google (optionnelle en local : sans elle, /api/v1/auth/google répond AUTH_UNAVAILABLE).
# Client OAuth « application web » créé sur la console Google Cloud ; ne jamais committer les vraies valeurs.
# URI de redirection autorisée : celle de GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# Origine du front (redirections après connexion, contrôle de l'en-tête Origin).
WEB_ORIGIN=http://localhost:3001
# Secret de session, 32 caractères au moins. Obligatoire en production ; en local, absent, un secret
# aléatoire vaut jusqu'au redémarrage (les connexions ne survivent pas à un redémarrage).
SESSION_SECRET=
# Cookie Secure : par défaut actif en production seulement (true/false pour forcer).
SECURE_COOKIES=
# Nombre de reverse proxys devant l'API en production (0 : aucun). Sans cela derrière un proxy
# HTTPS, le cookie de session Secure n'est jamais posé.
TRUST_PROXY=1
# Base de test jetable : vidée par les tests et `npm run db:seed`. Ne jamais pointer vers la base de travail.
TEST_DATABASE_URL=postgres://trame:changeme-local-only@127.0.0.1:5432/trame_demo
