# Copier ce fichier en .env puis adapter. Ne jamais committer .env.
# Valeurs d'exemple pour le développement local uniquement.

POSTGRES_DB=trame
POSTGRES_USER=trame
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_PORT=5432

# Utilisée par l'API et les migrations (ajoutée avec le dossier api/).
DATABASE_URL=postgres://trame:changeme-local-only@localhost:5432/trame