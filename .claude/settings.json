{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(git tag*)",
      "Bash(rtk git add*)",
      "Bash(rtk git commit*)",
      "Bash(rtk git push*)",
      "Bash(rtk git merge*)",
      "Bash(rtk git rebase*)",
      "Bash(rtk git reset*)",
      "Bash(rtk git tag*)",
      "Bash(gh pr merge*)",
      "Bash(gh issue delete*)",
      "Bash(gh repo *)",
      "Bash(rtk gh pr merge*)",
      "Bash(rtk gh issue delete*)",
      "Bash(rtk gh repo *)"
    ],
    "ask": [
      "Read(./private/docs/**)",
      "Read(./private/catalogue-depart/**)",
      "Read(./private/audit-*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-edited-file.mjs\"",
            "timeout": 120,
            "statusMessage": "ESLint (règles Sonar) sur le fichier modifié"
          }
        ]
      }
    ]
  }
}
