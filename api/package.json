{
  "name": "trame-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": "v26.13.0"
  },
  "scripts": {
    "migrate:up": "node --env-file-if-exists=../.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up --migrations-dir migrations",
    "migrate:test": "node --env-file-if-exists=../.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up --migrations-dir migrations --database-url-var TEST_DATABASE_URL",
    "migrate:down": "node --env-file-if-exists=../.env node_modules/node-pg-migrate/bin/node-pg-migrate.js down --migrations-dir migrations",
    "db:seed": "node --env-file-if-exists=../.env scripts/seed.mjs",
    "db:seed:bulk": "node --env-file-if-exists=../.env scripts/seed-bulk.mjs",
    "db:seed:bulk:remove": "node --env-file-if-exists=../.env scripts/seed-bulk.mjs --remove",
    "db:promote-admin": "node --env-file-if-exists=../.env scripts/promote-admin.mjs",
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:e2e": "tsc -p tsconfig.e2e.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/*.mjs\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/*.mjs\" \"*.ts\""
  },
  "dependencies": {
    "@scalar/express-api-reference": "0.10.29",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "express-session": "1.19.0",
    "google-auth-library": "11.3.1",
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "node-pg-migrate": "9.0.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.3"
  }
}
